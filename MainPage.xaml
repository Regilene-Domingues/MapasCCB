<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CCB_Mapas_App.MainPage">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Barra superior -->
        <Grid Grid.Row="0"
              Margin="12,8"
              ColumnDefinitions="*,Auto">

            <!-- Pesquisa -->
            <SearchBar x:Name="LocationSearchBar"
                       Grid.Column="0"
                       Placeholder="Pesquisar localidade"
                       SearchButtonPressed="LocationSearchBar_SearchButtonPressed"
                       TextChanged="LocationSearchBar_TextChanged"/>

            <!-- Seleção de país -->
            <Grid Grid.Column="1"
                  Margin="8,0,0,0">

                <Button x:Name="CountryButton"
                        Padding="12,0"
                        BackgroundColor="Transparent"
                        BorderColor="Transparent"
                        BorderWidth="0"
                        Text="País ▾"
                        TextColor="Gray"
                        Clicked="CountryButton_Clicked"/>

                <BoxView HeightRequest="1"
                         VerticalOptions="End"
                         Color="#0D47A1"
                         InputTransparent="True"/>

            </Grid>

        </Grid>

        <WebView x:Name="MapWebView"
                 Grid.Row="2"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"/>

    </Grid>

</ContentPage>