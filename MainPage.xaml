<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CCB_Mapas_App.MainPage">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Barra superior -->
        <Grid Grid.Row="0"
              Margin="12,8"
              ColumnDefinitions="*,Auto">

            <!-- Pesquisa -->
            <SearchBar x:Name="LocationSearchBar"
                       Grid.Column="0"
                       Placeholder="Pesquisar localidade"
                       SearchButtonPressed="LocationSearchBar_SearchButtonPressed"
                       TextChanged="LocationSearchBar_TextChanged"/>

            <!-- Seleção de país -->
            <Button x:Name="CountryButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    WidthRequest="48"
                    Text="🌍"
                    Clicked="CountryButton_Clicked"/>

        </Grid>

        <WebView x:Name="MapWebView"
                 Grid.Row="2"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"/>

    </Grid>

</ContentPage>